{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "htbp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MCP_SERVERS_JSON": "{}",
    "OAUTH_REQUIRED_AUDIENCE": ""
  }
}

